@model EquityHarbour.Areas.Admin.Models.DashboardViewModel

<div class="flex items-center justify-between mb-6">
    <p class="text-gray-500">Welcome back, Admin</p>
    <a asp-controller="InvestmentPlans" asp-action="Create"
       class="inline-flex items-center gap-2 bg-blue-950 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-blue-900">
        <i class="fa-solid fa-plus"></i> Create Plan
    </a>
</div>

<!-- KPI cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase">Total Users</p>
            <h3 class="text-2xl font-black text-gray-800 mt-1">@Model.TotalUsers.ToString("N0")</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-950 flex items-center justify-center">
            <i class="fa-solid fa-users text-xl"></i>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase">Active Investments</p>
            <h3 class="text-2xl font-black text-gray-800 mt-1">@Model.ActiveInvestments</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
            <i class="fa-solid fa-arrow-trend-up text-xl"></i>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase">Total Deposits</p>
            <h3 class="text-2xl font-black text-gray-800 mt-1">₦@Model.TotalDeposits.ToString("N0")</h3>
        </div>
        <div class="w-12 h-12 rounded-xl bg-yellow-50 text-yellow-600 flex items-center justify-center">
            <i class="fa-solid fa-wallet text-xl"></i>
        </div>
    </div>
</div>

<!-- Second row: totals + investment breakdown -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
    <div class="bg-white rounded-xl shadow-sm p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Withdrawals</p>
        <h3 class="text-2xl font-black text-gray-800 mt-1">₦@Model.TotalWithdrawals.ToString("N0")</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Invested</p>
        <h3 class="text-2xl font-black text-gray-800 mt-1">₦@Model.TotalInvested.ToString("N0")</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase mb-2">Investment Status</p>
        <div class="flex justify-between text-sm py-1 border-b border-gray-100">
            <span class="text-gray-600"><i class="fa-solid fa-circle text-green-600 text-[8px] me-2"></i>Active</span>
            <span class="font-bold text-gray-800">@Model.ActiveInvestments</span>
        </div>
        <div class="flex justify-between text-sm py-1 border-b border-gray-100">
            <span class="text-gray-600"><i class="fa-solid fa-circle text-blue-600 text-[8px] me-2"></i>Matured</span>
            <span class="font-bold text-gray-800">@Model.MaturedInvestments</span>
        </div>
        <div class="flex justify-between text-sm py-1">
            <span class="text-gray-600"><i class="fa-solid fa-circle text-red-600 text-[8px] me-2"></i>Cancelled</span>
            <span class="font-bold text-gray-800">@Model.CancelledInvestments</span>
        </div>
    </div>
</div>

<!-- Recent activity + widgets -->
<div class="grid grid-cols-1 xl:grid-cols-7 gap-4 mt-4">
    <div class="xl:col-span-4 bg-white rounded-xl shadow-sm">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
            <h6 class="font-bold text-gray-800">Recent Activity</h6>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-400 text-xs uppercase">
                        <th class="px-5 py-2">Reference</th>
                        <th class="px-3 py-2">Amount</th>
                        <th class="px-3 py-2">Status</th>
                        <th class="px-5 py-2 text-right">Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RecentActivity)
                    {
                        <tr class="border-t border-gray-100">
                            <td class="px-5 py-3">
                                <div class="font-bold text-gray-800">@a.Reference</div>
                                <div class="text-xs text-gray-400">@a.Type</div>
                            </td>
                            <td class="px-3 py-3 font-bold text-gray-800">₦@a.Amount.ToString("N2")</td>
                            <td class="px-3 py-3">
                                <span class="text-xs font-semibold px-2 py-1 rounded-full @(a.Status == "Completed" ? "bg-green-50 text-green-600" : a.Status == "Pending" ? "bg-yellow-50 text-yellow-600" : "bg-red-50 text-red-600")">
                                    @a.Status
                                </span>
                            </td>
                            <td class="px-5 py-3 text-right text-gray-400 text-xs">@a.CreatedAt.ToString("MMM dd")</td>
                        </tr>
                    }
                    @if (!Model.RecentActivity.Any())
                    {
                        <tr><td colspan="4" class="px-5 py-6 text-center text-gray-400">No recent activity.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="xl:col-span-3 space-y-4">
        <!-- Pending approvals -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="bg-red-50 px-5 py-3">
                <h6 class="font-bold text-red-600 text-sm">Pending Approvals</h6>
            </div>
            <a asp-controller="Deposits" asp-action="Index" class="flex items-center justify-between px-5 py-3 border-b border-gray-100 hover:bg-gray-50">
                <span class="text-sm font-bold text-gray-800"><i class="fa-solid fa-arrow-down text-yellow-500 me-2"></i>Deposits</span>
                <span class="bg-yellow-500 text-white text-xs font-bold rounded-full px-2 py-1">@Model.PendingDeposits</span>
            </a>
            <a asp-controller="Withdrawals" asp-action="Index" class="flex items-center justify-between px-5 py-3 hover:bg-gray-50">
                <span class="text-sm font-bold text-gray-800"><i class="fa-solid fa-arrow-up text-red-500 me-2"></i>Withdrawals</span>
                <span class="bg-red-500 text-white text-xs font-bold rounded-full px-2 py-1">@Model.PendingWithdrawals</span>
            </a>
        </div>

        <!-- Recent users -->
        <div class="bg-white rounded-xl shadow-sm">
            <div class="px-5 py-3 border-b border-gray-100">
                <h6 class="font-bold text-gray-800 text-sm">New User Registrations</h6>
            </div>
            <div class="p-4 space-y-3">
                @foreach (var u in Model.RecentUsers)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-full bg-blue-50 text-blue-950 flex items-center justify-center text-xs font-bold">
                                @(u.FullName.Length > 0 ? u.FullName[..1].ToUpper() : "?")
                            </div>
                            <div>
                                <div class="text-sm font-bold text-gray-800">@u.FullName</div>
                                <div class="text-xs text-gray-400">@u.Email</div>
                            </div>
                        </div>
                        <a asp-controller="Users" asp-action="Details" asp-route-id="@u.Id"
                           class="text-xs font-bold bg-gray-100 rounded-full px-3 py-1.5 hover:bg-gray-200">Profile</a>
                    </div>
                }
                @if (!Model.RecentUsers.Any())
                {
                    <p class="text-sm text-gray-400 text-center py-2">No users yet.</p>
                }
            </div>
        </div>
    </div>
</div>