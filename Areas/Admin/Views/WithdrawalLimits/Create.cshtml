@model EquityHarbour.DTOs.WithdrawalLimits.CreateWithdrawalLimitTierRequest

<div class="max-w-xl mx-auto bg-white rounded-xl shadow-sm p-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-4 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-2">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="WithdrawalLimits" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="MinInvestedAmount" class="block text-sm font-semibold text-gray-700 mb-1">Min Invested (₦)</label>
                <input asp-for="MinInvestedAmount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
            <div>
                <label asp-for="MaxInvestedAmount" class="block text-sm font-semibold text-gray-700 mb-1">Max Invested (₦)</label>
                <input asp-for="MaxInvestedAmount" type="number" step="0.01" placeholder="Leave blank for no upper limit"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div>
                <label asp-for="MinWithdrawalAmount" class="block text-sm font-semibold text-gray-700 mb-1">Min Withdrawal (₦)</label>
                <input asp-for="MinWithdrawalAmount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
            <div>
                <label asp-for="MaxWithdrawalAmount" class="block text-sm font-semibold text-gray-700 mb-1">Max Withdrawal (₦)</label>
                <input asp-for="MaxWithdrawalAmount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-controller="WithdrawalLimits" asp-action="Index"
               class="px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-600">Cancel</a>
            <button type="submit" class="px-4 py-2 rounded-lg bg-blue-950 text-white text-sm font-semibold">
                <i class="fa-solid fa-check me-1"></i> Add Tier
            </button>
        </div>
    </form>
</div>