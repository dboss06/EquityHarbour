@model List<EquityHarbour.DTOs.InvestmentPlans.InvestmentPlanDto>
@{
    var investorCounts = ViewBag.InvestorCounts as Dictionary<int, int>;
}

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Active Plans</p>
        <h3 class="text-2xl font-black text-green-600 mt-1">@Model.Count(p => p.IsActive)</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Investors</p>
        <h3 class="text-2xl font-black text-red-500 mt-1">@ViewBag.TotalInvestors</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Invested</p>
        <h3 class="text-2xl font-black text-blue-950 mt-1">₦@(((decimal)ViewBag.TotalInvested).ToString("N2"))</h3>
    </div>
</div>

<div class="flex justify-end mb-4">
    <a asp-controller="InvestmentPlans" asp-action="Create"
       class="inline-flex items-center gap-2 bg-blue-950 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-blue-900">
        <i class="fa-solid fa-plus"></i> Create Plan
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50">
                    <tr class="text-left text-gray-400 text-xs uppercase">
                        <th class="px-5 py-3">Plan</th>
                        <th class="px-3 py-3">Minimum</th>
                        <th class="px-3 py-3">Return</th>
                        <th class="px-3 py-3">Duration</th>
                        <th class="px-3 py-3">Investors</th>
                        <th class="px-3 py-3">Status</th>
                        <th class="px-5 py-3 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        var investorCount = investorCounts != null && investorCounts.ContainsKey(plan.Id) ? investorCounts[plan.Id] : 0;
                        <tr class="border-t border-gray-100">
                            <td class="px-5 py-3 font-bold text-gray-800">@plan.Name</td>
                            <td class="px-3 py-3 text-gray-600">₦@plan.MinimumAmount.ToString("N0")</td>
                            <td class="px-3 py-3 text-green-600 font-bold">
                                @(plan.ReturnType == EquityHarbour.Models.InvestmentReturnType.Percentage ? $"{plan.ReturnValue}%" : $"₦{plan.ReturnValue:N0}")
                            </td>
                            <td class="px-3 py-3 text-gray-600">@plan.DurationDays days</td>
                            <td class="px-3 py-3 text-gray-600">@investorCount</td>
                            <td class="px-3 py-3">
                                @if (plan.IsActive)
                                {
                                    <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full">Active</span>
                                }
                                else
                                {
                                    <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Inactive</span>
                                }
                            </td>
                            <td class="px-5 py-3">
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-controller="InvestmentPlans" asp-action="Edit" asp-route-id="@plan.Id"
                                       class="w-8 h-8 flex items-center justify-center rounded-lg border border-blue-950 text-blue-950 hover:bg-blue-50">
                                        <i class="fa-solid fa-pencil text-xs"></i>
                                    </a>
                                    <form asp-controller="InvestmentPlans" asp-action="ToggleStatus" asp-route-id="@plan.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="w-8 h-8 flex items-center justify-center rounded-lg border @(plan.IsActive ? "border-yellow-500 text-yellow-500 hover:bg-yellow-50" : "border-green-600 text-green-600 hover:bg-green-50")"
                                                title="@(plan.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fa-solid @(plan.IsActive ? "fa-pause" : "fa-play") text-xs"></i>
                                        </button>
                                    </form>
                                    <button type="button"
                                            class="delete-btn w-8 h-8 flex items-center justify-center rounded-lg border border-red-500 text-red-500 hover:bg-red-50"
                                            data-id="@plan.Id" data-name="@plan.Name">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-12">
            <i class="fa-solid fa-chart-line text-4xl text-gray-300"></i>
            <p class="mt-3 font-bold text-gray-600">No Investment Plans</p>
            <p class="text-sm text-gray-400">There are currently no investment plans available.</p>
            <a asp-controller="InvestmentPlans" asp-action="Create"
               class="inline-block mt-4 bg-blue-950 text-white text-sm font-semibold px-4 py-2 rounded-lg">Create Plan</a>
        </div>
    }
</div>

<div id="deleteModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50 px-4">
    <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center">
        <i class="fa-solid fa-triangle-exclamation text-4xl text-red-500"></i>
        <h3 class="mt-3 text-lg font-bold text-gray-800">Are you sure?</h3>
        <p class="mt-1 text-sm text-gray-500">You are about to delete <strong id="deletePlanName"></strong>.</p>
        <p class="text-xs text-red-500 mt-1">This action cannot be undone, and will fail if the plan has any investments.</p>
        <form id="deleteForm" method="post" class="mt-5 flex gap-3">
            @Html.AntiForgeryToken()
            <button type="button" id="deleteCancel" class="flex-1 rounded-lg border border-gray-200 py-2 text-sm font-semibold text-gray-600">Cancel</button>
            <button type="submit" class="flex-1 rounded-lg bg-red-600 py-2 text-sm font-semibold text-white">Delete</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById("deleteModal");
        document.querySelectorAll(".delete-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                document.getElementById("deletePlanName").textContent = btn.dataset.name;
                document.getElementById("deleteForm").action = "/Admin/InvestmentPlans/Delete/" + btn.dataset.id;
                deleteModal.classList.remove("hidden");
                deleteModal.classList.add("flex");
            });
        });
        document.getElementById("deleteCancel").addEventListener("click", () => {
            deleteModal.classList.add("hidden");
            deleteModal.classList.remove("flex");
        });
    </script>
}