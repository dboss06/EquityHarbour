@model EquityHarbour.DTOs.InvestmentPlans.CreateInvestmentPlanRequest
@using EquityHarbour.Models

<div class="max-w-3xl mx-auto bg-white rounded-xl shadow-sm p-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-4 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-2">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="InvestmentPlans" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4">
            <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1">Plan Name</label>
            <input asp-for="Name" placeholder="e.g. Growth Plan" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="MinimumAmount" class="block text-sm font-semibold text-gray-700 mb-1">Minimum Amount (₦)</label>
                <input asp-for="MinimumAmount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
            <div>
                <label asp-for="MaximumAmount" class="block text-sm font-semibold text-gray-700 mb-1">Maximum Amount (₦)</label>
                <input asp-for="MaximumAmount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div>
                <label asp-for="ReturnType" class="block text-sm font-semibold text-gray-700 mb-1">Return Type</label>
                <select asp-for="ReturnType" asp-items="Html.GetEnumSelectList<InvestmentReturnType>()"
                        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950"></select>
            </div>
            <div>
                <label asp-for="ReturnValue" class="block text-sm font-semibold text-gray-700 mb-1">Return Value</label>
                <input asp-for="ReturnValue" type="number" step="0.01" placeholder="e.g. 15 for 15%, or a fixed ₦ amount" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
            <div>
                <label asp-for="DurationDays" class="block text-sm font-semibold text-gray-700 mb-1">Duration (Days)</label>
                <input asp-for="DurationDays" type="number" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <div>
                <label asp-for="PayoutFrequency" class="block text-sm font-semibold text-gray-700 mb-1">Payout Frequency</label>
                <select asp-for="PayoutFrequency" asp-items="Html.GetEnumSelectList<InvestmentPayoutFrequency>()"
                        class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950"></select>
            </div>
            <div>
                <label asp-for="IsActive" class="block text-sm font-semibold text-gray-700 mb-1">Plan Status</label>
                <select asp-for="IsActive" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <div class="mb-6">
            <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
            <textarea asp-for="Description" rows="4" placeholder="Describe this investment plan..."
                      class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950"></textarea>
        </div>

        <div class="flex justify-end gap-3">
            <a asp-controller="InvestmentPlans" asp-action="Index"
               class="px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-600">Cancel</a>
            <button type="submit" class="px-4 py-2 rounded-lg bg-blue-950 text-white text-sm font-semibold">
                <i class="fa-solid fa-check me-1"></i> Create Plan
            </button>
        </div>
    </form>
</div>