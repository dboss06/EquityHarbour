@model List<EquityHarbour.DTOs.GiftCodes.GiftCodeDto>

<div class="flex justify-end mb-4">
    <a asp-controller="GiftCodes" asp-action="Create"
       class="inline-flex items-center gap-2 bg-blue-950 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-blue-900">
        <i class="fa-solid fa-plus"></i> Create Code
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    @if (Model.Any())
    {
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="px-5 py-3">Code</th>
                    <th class="px-3 py-3">Amount</th>
                    <th class="px-3 py-3">Status</th>
                    <th class="px-3 py-3">Redeemed By</th>
                    <th class="px-5 py-3">Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr class="border-t border-gray-100">
                        <td class="px-5 py-3 font-mono font-bold text-gray-800">@g.Code</td>
                        <td class="px-3 py-3 font-bold text-gray-800">₦@g.Amount.ToString("N2")</td>
                        <td class="px-3 py-3">
                            @if (g.IsRedeemed)
                            {
                                <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Redeemed</span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full">Active</span>
                            }
                        </td>
                        <td class="px-3 py-3 text-gray-600">@(g.RedeemedByUserFullName ?? "-")</td>
                        <td class="px-5 py-3 text-gray-400 text-xs">@g.CreatedAt.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-12">
            <i class="fa-solid fa-gift text-4xl text-gray-300"></i>
            <p class="mt-3 font-bold text-gray-600">No Gift Codes</p>
        </div>
    }
</div>