@model EquityHarbour.DTOs.GiftCodes.CreateGiftCodeRequest

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm p-6">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-4 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-2">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="GiftCodes" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-6">
            <label asp-for="Amount" class="block text-sm font-semibold text-gray-700 mb-1">Amount (₦)</label>
            <input asp-for="Amount" type="number" step="0.01" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
        </div>
        <div class="flex justify-end gap-3">
            <a asp-controller="GiftCodes" asp-action="Index"
               class="px-4 py-2 rounded-lg border border-gray-200 text-sm font-semibold text-gray-600">Cancel</a>
            <button type="submit" class="px-4 py-2 rounded-lg bg-blue-950 text-white text-sm font-semibold">
                <i class="fa-solid fa-check me-1"></i> Generate Code
            </button>
        </div>
    </form>
</div>