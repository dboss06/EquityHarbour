@model List<EquityHarbour.DTOs.DepositAccounts.DepositAccountDto>

<div class="flex justify-end mb-4">
    <a asp-controller="DepositAccounts" asp-action="Create"
       class="inline-flex items-center gap-2 bg-blue-950 text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-blue-900">
        <i class="fa-solid fa-plus"></i> Add Account
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    @if (Model.Any())
    {
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="px-5 py-3">Bank</th>
                    <th class="px-3 py-3">Account Number</th>
                    <th class="px-3 py-3">Account Name</th>
                    <th class="px-3 py-3">Order</th>
                    <th class="px-3 py-3">Status</th>
                    <th class="px-5 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var acc in Model)
                {
                    <tr class="border-t border-gray-100">
                        <td class="px-5 py-3 font-bold text-gray-800">@acc.BankName</td>
                        <td class="px-3 py-3 text-gray-600">@acc.AccountNumber</td>
                        <td class="px-3 py-3 text-gray-600">@acc.AccountName</td>
                        <td class="px-3 py-3 text-gray-600">@acc.DisplayOrder</td>
                        <td class="px-3 py-3">
                            @if (acc.IsActive)
                            {
                                <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-gray-500 bg-gray-100 px-2 py-1 rounded-full">Inactive</span>
                            }
                        </td>
                        <td class="px-5 py-3">
                            <div class="flex items-center justify-center gap-2">
                                <form asp-controller="DepositAccounts" asp-action="ToggleActive" asp-route-id="@acc.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="w-8 h-8 flex items-center justify-center rounded-lg border @(acc.IsActive ? "border-yellow-500 text-yellow-500 hover:bg-yellow-50" : "border-green-600 text-green-600 hover:bg-green-50")">
                                        <i class="fa-solid @(acc.IsActive ? "fa-pause" : "fa-play") text-xs"></i>
                                    </button>
                                </form>
                                <form asp-controller="DepositAccounts" asp-action="Delete" asp-route-id="@acc.Id" method="post"
                                      onsubmit="return confirm('Delete this account?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="w-8 h-8 flex items-center justify-center rounded-lg border border-red-500 text-red-500 hover:bg-red-50">
                                        <i class="fa-solid fa-trash text-xs"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-12">
            <i class="fa-solid fa-building-columns text-4xl text-gray-300"></i>
            <p class="mt-3 font-bold text-gray-600">No Deposit Accounts</p>
            <p class="text-sm text-gray-400">Add an account for users to deposit into.</p>
        </div>
    }
</div>