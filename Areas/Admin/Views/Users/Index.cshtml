@model List<EquityHarbour.Areas.Admin.Models.UserListItemViewModel>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Users</p>
        <h3 class="text-2xl font-black text-green-600 mt-1">@Model.Count</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Investors</p>
        <h3 class="text-2xl font-black text-red-500 mt-1">@Model.Count(u => u.InvestmentCount > 0)</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Wallet Holdings</p>
        <h3 class="text-2xl font-black text-blue-950 mt-1">₦@Model.Sum(x => x.WalletBalance).ToString("N2")</h3>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="px-5 py-3">User</th>
                    <th class="px-3 py-3">Email</th>
                    <th class="px-3 py-3">Wallet</th>
                    <th class="px-3 py-3">Investments</th>
                    <th class="px-3 py-3">Transactions</th>
                    <th class="px-3 py-3">Status</th>
                    <th class="px-5 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="border-t border-gray-100">
                        <td class="px-5 py-3 font-bold text-gray-800">@user.FullName</td>
                        <td class="px-3 py-3 text-gray-600">@user.Email</td>
                        <td class="px-3 py-3">
                            <span class="bg-green-50 text-green-600 text-xs font-bold px-2 py-1 rounded-full">₦@user.WalletBalance.ToString("N2")</span>
                        </td>
                        <td class="px-3 py-3 text-gray-600">@user.InvestmentCount</td>
                        <td class="px-3 py-3 text-gray-600">@user.TransactionCount</td>
                        <td class="px-3 py-3">
                            @if (user.IsActive)
                            {
                                <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full">Active</span>
                            }
                            else
                            {
                                <span class="text-xs font-bold text-red-600 bg-red-50 px-2 py-1 rounded-full">Deactivated</span>
                            }
                        </td>
                        <td class="px-5 py-3 text-center">
                            <div class="flex items-center justify-center gap-2">
                                <a asp-controller="Users" asp-action="Details" asp-route-id="@user.Id"
                                   class="w-8 h-8 flex items-center justify-center rounded-lg border border-blue-950 text-blue-950 hover:bg-blue-50">
                                    <i class="fa-solid fa-eye text-xs"></i>
                                </a>
                                <button type="button"
                                        class="toggle-btn w-8 h-8 flex items-center justify-center rounded-lg @(user.IsActive ? "border border-red-500 text-red-500 hover:bg-red-50" : "border border-green-600 text-green-600 hover:bg-green-50")"
                                        data-id="@user.Id" data-name="@user.FullName" data-active="@user.IsActive.ToString().ToLower()">
                                    <i class="fa-solid @(user.IsActive ? "fa-user-slash" : "fa-user-check") text-xs"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">No users yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Deactivate/Reactivate confirm modal -->
<div id="toggleModal" class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50 px-4">
    <div class="w-full max-w-sm rounded-xl bg-white p-6 text-center">
        <i id="toggleIcon" class="fa-solid text-4xl"></i>
        <h3 class="mt-3 text-lg font-bold text-gray-800">Are you sure?</h3>
        <p class="mt-1 text-sm text-gray-500">
            You are about to <span id="toggleActionText" class="font-semibold"></span>
            <strong id="toggleUserName"></strong>.
        </p>
        <form asp-controller="Users" asp-action="ToggleActive" method="post" class="mt-5 flex gap-3">
            @Html.AntiForgeryToken()
            <input type="hidden" id="toggleUserId" name="id" />
            <button type="button" id="toggleCancel" class="flex-1 rounded-lg border border-gray-200 py-2 text-sm font-semibold text-gray-600">Cancel</button>
            <button type="submit" class="flex-1 rounded-lg bg-blue-950 py-2 text-sm font-semibold text-white">Confirm</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById("toggleModal");
        document.querySelectorAll(".toggle-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const isActive = btn.dataset.active === "true";
                document.getElementById("toggleUserId").value = btn.dataset.id;
                document.getElementById("toggleUserName").textContent = btn.dataset.name;
                document.getElementById("toggleActionText").textContent = isActive ? "deactivate" : "reactivate";
                const icon = document.getElementById("toggleIcon");
                icon.className = isActive
                    ? "fa-solid fa-triangle-exclamation text-4xl text-red-500"
                    : "fa-solid fa-circle-check text-4xl text-green-600";
                modal.classList.remove("hidden");
                modal.classList.add("flex");
            });
        });
        document.getElementById("toggleCancel").addEventListener("click", () => {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
        });
    </script>
}