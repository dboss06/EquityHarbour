@model EquityHarbour.Areas.Admin.Models.UserDetailsViewModel

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Wallet Balance</p>
        <h3 class="text-2xl font-black text-green-600 mt-1">₦@Model.WalletBalance.ToString("N2")</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Investments</p>
        <h3 class="text-2xl font-black text-red-500 mt-1">@Model.Investments.Count</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Transactions</p>
        <h3 class="text-2xl font-black text-blue-950 mt-1">@Model.Transactions.Count</h3>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-5 mb-4">
    <h4 class="font-bold text-gray-800 mb-4">Profile Information</h4>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Full Name</p>
            <p class="text-gray-800 font-medium">@Model.FullName</p>
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Email</p>
            <p class="text-gray-800 font-medium">@Model.Email</p>
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Username</p>
            <p class="text-gray-800 font-medium">@Model.UserName</p>
        </div>
        <div>
            <p class="text-xs font-semibold text-gray-400 uppercase mb-1">Status</p>
            @if (Model.IsActive)
            {
                <span class="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded-full">Active</span>
            }
            else
            {
                <span class="text-xs font-bold text-red-600 bg-red-50 px-2 py-1 rounded-full">Deactivated</span>
            }
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-5 mb-4">
    <h4 class="font-bold text-gray-800 mb-4">Investments</h4>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="py-2">Plan</th>
                    <th class="py-2">Amount</th>
                    <th class="py-2">Status</th>
                    <th class="py-2">Maturity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in Model.Investments.OrderByDescending(i => i.CreatedAt))
                {
                    <tr class="border-t border-gray-100">
                        <td class="py-2 font-medium text-gray-800">@inv.InvestmentPlanName</td>
                        <td class="py-2 text-gray-600">₦@inv.PrincipalAmount.ToString("N2")</td>
                        <td class="py-2 text-gray-600">@inv.Status</td>
                        <td class="py-2 text-gray-600">@(inv.MaturityDate?.ToString("MMM d, yyyy") ?? "-")</td>
                    </tr>
                }
                @if (!Model.Investments.Any())
                {
                    <tr><td colspan="4" class="py-6 text-center text-gray-400">No investments.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-5">
    <h4 class="font-bold text-gray-800 mb-4">Transactions</h4>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="py-2">Reference</th>
                    <th class="py-2">Type</th>
                    <th class="py-2">Amount</th>
                    <th class="py-2">Status</th>
                    <th class="py-2">Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    <tr class="border-t border-gray-100">
                        <td class="py-2 text-gray-600">@tx.Reference</td>
                        <td class="py-2 text-gray-600">@tx.Type</td>
                        <td class="py-2 text-gray-600">₦@tx.Amount.ToString("N2")</td>
                        <td class="py-2 text-gray-600">@tx.Status</td>
                        <td class="py-2 text-gray-600">@tx.CreatedAt.ToString("MMM d, yyyy")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="5" class="py-6 text-center text-gray-400">No transactions.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>