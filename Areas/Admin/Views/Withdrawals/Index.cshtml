@model List<EquityHarbour.DTOs.Withdrawal.WithdrawalDto>
@using EquityHarbour.Models.Enums

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Pending</p>
        <h3 class="text-2xl font-black text-yellow-600 mt-1">@Model.Count(w => w.Status == WithdrawalStatus.Pending)</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Completed</p>
        <h3 class="text-2xl font-black text-green-600 mt-1">@Model.Count(w => w.Status == WithdrawalStatus.Completed)</h3>
    </div>
    <div class="bg-white rounded-xl shadow-sm p-5 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase">Total Paid Out</p>
        <h3 class="text-2xl font-black text-blue-950 mt-1">₦@Model.Where(w => w.Status == WithdrawalStatus.Completed).Sum(w => w.Amount).ToString("N2")</h3>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gray-50">
                <tr class="text-left text-gray-400 text-xs uppercase">
                    <th class="px-5 py-3">User</th>
                    <th class="px-3 py-3">Reference</th>
                    <th class="px-3 py-3">Amount</th>
                    <th class="px-3 py-3">Bank Details</th>
                    <th class="px-3 py-3">Status</th>
                    <th class="px-3 py-3">Date</th>
                    <th class="px-5 py-3 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model)
                {
                    <tr class="border-t border-gray-100">
                        <td class="px-5 py-3 font-bold text-gray-800">@w.UserFullName</td>
                        <td class="px-3 py-3 text-gray-600 text-xs">@w.Reference</td>
                        <td class="px-3 py-3 font-bold text-gray-800">₦@w.Amount.ToString("N2")</td>
                        <td class="px-3 py-3 text-gray-600 text-xs">
                            @w.BankName<br />
                            <span class="text-gray-400">@w.AccountNumber &middot; @w.AccountName</span>
                        </td>
                        <td class="px-3 py-3">
                            <span class="text-xs font-semibold px-2 py-1 rounded-full @(w.Status == WithdrawalStatus.Completed ? "bg-green-50 text-green-600" : w.Status == WithdrawalStatus.Pending ? "bg-yellow-50 text-yellow-600" : "bg-red-50 text-red-600")">
                                @w.Status
                            </span>
                        </td>
                        <td class="px-3 py-3 text-gray-400 text-xs">@w.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="px-5 py-3">
                            @if (w.Status == WithdrawalStatus.Pending)
                            {
                                <div class="flex items-center justify-center gap-2">
                                    <form asp-controller="Withdrawals" asp-action="Approve" asp-route-id="@w.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-lg border border-green-600 text-green-600 hover:bg-green-50">
                                            <i class="fa-solid fa-check text-xs"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Withdrawals" asp-action="Reject" asp-route-id="@w.Id" method="post"
                                          onsubmit="return confirm('Reject this withdrawal? Funds will be returned to the user.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-8 h-8 flex items-center justify-center rounded-lg border border-red-500 text-red-500 hover:bg-red-50">
                                            <i class="fa-solid fa-xmark text-xs"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400 text-center block">—</span>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="px-5 py-8 text-center text-gray-400">No withdrawals yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>