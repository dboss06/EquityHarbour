@{
    ViewData["Title"] = "Invite Friends";
}

<nav class="fixed top-0 left-0 w-full bg-white shadow-gray-100 z-50">
    <div class="flex items-center justify-between px-8 md:px-12 lg:px-50 py-2">
        <div class="flex items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="flex flex-col items-center gap-1 text-blue-950">
                <span class="material-symbols-rounded icon-fill text-blue-950">arrow_back_ios</span>
            </a>
        </div>
        <div class="text-center">
            <h1 class="text-lg font-medium text-gray-700">Invite Friends</h1>
        </div>
        <div class="flex items-center gap-1.5 text-sm font-medium px-3 py-1 rounded-full">
            <a asp-controller="Referrals" asp-action="Index" class="text-md font-medium text-blue-950">My Team</a>
        </div>
    </div>
</nav>

<main class="pt-10 pb-20 min-h-screen bg-gray-100">
    <div class="mt-7 mx-2 md:mx-12 lg:mx-50 bg-white text-white rounded-xl p-7 px-3 md:p-6 lg:p-3 lg:px-5 shadow-xl">
        <h1 class="text-xl text-gray-700 font-extrabold mt-2">My Invite Link</h1>
        <div class="flex items-center gap-3 mt-4">
            <input type="text" id="inviteLink" readonly value="@ViewData["InviteLink"]"
                   class="w-full px-4 py-3 text-sm text-slate-600 bg-white border border-blue-950 rounded-xl focus:outline-none select-all" />
            <button id="copyBtn" type="button"
                    class="flex items-center justify-center p-2 text-blue-950 border border-blue-950 rounded-xl hover:bg-blue-950/10 active:scale-95 transition-all shrink-0"
                    title="Copy to clipboard">
                <span class="material-symbols-rounded text-lg">content_copy</span>
            </button>
        </div>
    </div>

    <div class="mt-5 mx-2 md:mx-12 lg:mx-50 bg-white text-white rounded-xl p-7 px-3 md:p-6 lg:p-3 lg:px-5 shadow-xl flex">
        <div class="flex items-center justify-center w-12 h-12 bg-orange-100 rounded-xl m-1 p-7">
            <span class="material-symbols-rounded [font-variation-settings:'FILL'_1] text-orange-600 text-2xl">person</span>
        </div>
        <div class="flex font-semibold flex-col ms-4">
            <h1 class="text-gray-700 text-md font-bold">Direct Referrals</h1>
            <p class="bg-orange-500 px-4 py-1.5 text-xs font-bold rounded-sm">Earn 20% commission</p>
        </div>
    </div>

    <div class="mt-2 mx-2 md:mx-12 lg:mx-50 bg-white text-white rounded-xl p-7 px-3 md:p-6 lg:p-3 lg:px-5 shadow-xl flex">
        <div class="flex items-center justify-center w-12 h-12 bg-purple-100 rounded-xl m-1 p-7">
            <span class="material-symbols-rounded [font-variation-settings:'FILL'_1] text-purple-600 text-2xl">group</span>
        </div>
        <div class="flex font-semibold flex-col ms-4">
            <h1 class="text-gray-700 text-md font-bold">Second Level</h1>
            <p class="bg-purple-600 px-4 py-1.5 text-xs font-bold rounded-sm">Earn 10% commission</p>
        </div>
    </div>

    <div class="mt-2 mx-2 md:mx-12 lg:mx-50 bg-white text-white rounded-xl p-7 px-3 py-4 md:p-6 lg:p-3 lg:px-5 shadow-xl flex">
        <div class="flex items-center justify-center w-12 h-12 bg-green-100 rounded-xl m-1 p-7">
            <span class="material-symbols-rounded [font-variation-settings:'FILL'_1] text-green-600 text-2xl">groups_3</span>
        </div>
        <div class="flex font-semibold flex-col ms-4">
            <h1 class="text-gray-700 text-md font-bold">Third Level</h1>
            <p class="bg-green-600 px-4 py-1.5 text-xs font-bold rounded-sm">Earn 5% commission</p>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById("copyBtn").addEventListener("click", function () {
            const linkInput = document.getElementById("inviteLink");
            linkInput.select();
            linkInput.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(linkInput.value).then(() => {
                const copyBtn = document.getElementById("copyBtn");
                copyBtn.classList.add("bg-blue-950", "text-white");
                setTimeout(() => copyBtn.classList.remove("bg-blue-950", "text-white"), 1500);
            });
        });
    </script>
}