@model EquityHarbour.Models.ViewModels.BankAccountViewModel
@{
    ViewData["Title"] = "Bank";
}

<nav class="fixed top-0 left-0 w-full bg-white shadow-gray-100 z-50">
    <div class="flex items-center justify-between px-8 md:px-12 lg:px-50 py-2">
        <div class="flex items-center gap-3">
            <a asp-controller="Profile" asp-action="Index" class="flex flex-col items-center gap-1 text-blue-950">
                <span class="material-symbols-rounded icon-fill">arrow_back_ios</span>
            </a>
        </div>
        <div class="text-center">
            <h1 class="text-lg font-medium text-gray-700">Bank</h1>
        </div>
        <div class="flex items-center gap-1.5 text-sm font-medium px-3 py-1 rounded-full">
            <a asp-controller="Transactions" asp-action="Index" class="text-md font-medium text-blue-950">History</a>
        </div>
    </div>
</nav>

<main class="px-3 md:px-12 lg:px-75 pt-20 mb-15 min-h-screen bg-gray-100 pb-3">

    @if (TempData["Success"] != null)
    {
        <div class="mb-3 rounded-lg bg-green-50 text-green-700 text-sm px-4 py-2">@TempData["Success"]</div>
    }

    <form asp-controller="Bank" asp-action="Add" method="post" class="w-full rounded-xl bg-white p-5 shadow-sm">
        @Html.AntiForgeryToken()

        <!-- Account Number -->
        <div class="border-b border-gray-200 pb-4">
            <label asp-for="AccountNumber" class="block text-sm font-semibold text-gray-900">
                Account Number
            </label>
            <div class="mt-4 flex items-center">
                <input asp-for="AccountNumber" type="text" inputmode="numeric" placeholder="Enter account number"
                       class="w-full border-0 bg-transparent px-2 text-sm outline-none">
            </div>
            <span asp-validation-for="AccountNumber" class="text-xs text-red-600"></span>
        </div>

        <!-- Bank Name -->
        <div class="border-b border-gray-200 py-3">
            <label asp-for="BankName" class="block text-sm font-semibold text-gray-900">
                Bank Name
            </label>
            <input asp-for="BankName" type="text" placeholder="Enter bank name"
                   class="mt-3 w-full border-0 bg-transparent px-2 text-sm outline-none">
            <span asp-validation-for="BankName" class="text-xs text-red-600"></span>
        </div>

        <!-- Account Name -->
        <div class="border-b border-gray-200 py-3">
            <label asp-for="AccountName" class="block text-sm font-semibold text-gray-900">
                Account Name
            </label>
            <input asp-for="AccountName" type="text" placeholder="Enter account name"
                   class="mt-3 w-full border-0 bg-transparent px-2 text-sm outline-none">
            <span asp-validation-for="AccountName" class="text-xs text-red-600"></span>
        </div>

        <!-- Add Bank -->
        <button type="submit"
                class="mt-7 h-[50px] w-full rounded-xl bg-blue-950 text-sm font-bold text-white transition hover:bg-blue-900">
            Save Bank Details
        </button>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}