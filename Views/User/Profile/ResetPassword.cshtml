@model EquityHarbour.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<nav class="fixed top-0 left-0 w-full bg-white shadow-gray-100 z-50">
    <div class="flex items-center justify-between px-8 md:px-12 lg:px-50 py-2">
        <div class="flex items-center gap-3">
            <a asp-controller="Profile" asp-action="Index" class="flex flex-col items-center gap-1 text-blue-950">
                <span class="material-symbols-rounded icon-fill text-blue-950">arrow_back_ios</span>
            </a>
        </div>
        <div class="text-center">
            <h1 class="text-lg font-medium text-gray-700">Reset Password</h1>
        </div>
        <div class="flex items-center gap-1.5 text-sm font-medium px-3 py-1 rounded-full"></div>
    </div>
</nav>

<main class="px-3 md:px-12 lg:px-75 pt-20 mb-15 min-h-screen bg-gray-100 pb-3">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-3 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-2">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="Profile" asp-action="ResetPassword" method="post" class="w-full rounded-xl bg-white p-5 shadow-sm">
        @Html.AntiForgeryToken()

        <div class="border-b border-gray-200 pb-4">
            <label asp-for="CurrentPassword" class="block text-sm font-semibold text-gray-900">Current Password</label>
            <input asp-for="CurrentPassword" type="password" placeholder="Enter current password"
                   class="mt-3 w-full border-0 bg-transparent px-2 text-sm outline-none">
            <span asp-validation-for="CurrentPassword" class="text-xs text-red-600"></span>
        </div>

        <div class="border-b border-gray-200 py-3">
            <label asp-for="NewPassword" class="block text-sm font-semibold text-gray-900">New Password</label>
            <input asp-for="NewPassword" type="password" placeholder="Enter new password"
                   class="mt-3 w-full border-0 bg-transparent px-2 text-sm outline-none">
            <span asp-validation-for="NewPassword" class="text-xs text-red-600"></span>
        </div>

        <div class="py-3">
            <label asp-for="ConfirmPassword" class="block text-sm font-semibold text-gray-900">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password" placeholder="Confirm new password"
                   class="mt-3 w-full border-0 bg-transparent px-2 text-sm outline-none">
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600"></span>
        </div>

        <button type="submit"
                class="mt-7 h-[50px] w-full rounded-xl bg-blue-950 text-sm font-bold text-white transition hover:bg-blue-900">
            Update Password
        </button>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}