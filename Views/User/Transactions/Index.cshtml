@using EquityHarbour.Helpers
@model List<EquityHarbour.DTOs.WalletTransactionDTO>
@{
    ViewData["Title"] = "Transaction History";

    (string sign, string amountClass) AmountStyle(EquityHarbour.DTOs.WalletTransactionDTO tx)
    {
        if (tx.Status is "Failed" or "Rejected" or "Reversed")
            return ("", "text-gray-400");
        if (tx.Type == "Deposit")
            return ("+", "text-green-600");
        if (tx.Type == "Withdrawal")
            return ("-", "text-red-600");
        return ("", "text-gray-700");
    }

    string StatusClass(string status) => status switch
    {
        "Completed" => "text-green-600",
        "Pending" => "text-cyan-600",
        "Failed" or "Rejected" or "Reversed" => "text-red-600",
        _ => "text-gray-500"
    };

    string FriendlyTitle(EquityHarbour.DTOs.WalletTransactionDTO tx)
    {
        if (!string.IsNullOrWhiteSpace(tx.Description)) return tx.Description;
        return tx.Type switch
        {
            "Deposit" => "Deposit via Bank Transfer",
            "Withdrawal" => "Payout to Bank Account",
            _ => tx.Type
        };
    }
}

<nav class="fixed top-0 left-0 w-full bg-white shadow-gray-100 z-50">
    <div class="flex items-center justify-between px-8 md:px-12 lg:px-50 py-2">
        <div class="flex items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="flex flex-col items-center gap-1 text-blue-950">
                <span class="material-symbols-rounded icon-fill text-blue-950">arrow_back_ios</span>
            </a>
        </div>
        <div class="text-center">
            <h1 class="text-lg font-medium text-gray-700">Transaction History</h1>
        </div>
        <div class="flex items-center gap-1.5 text-sm font-medium px-3 py-1 rounded-full"></div>
    </div>
</nav>

<main class="pt-15 pb-20 min-h-screen bg-gray-100">
    <div class="w-full max-w-5xl mx-auto px-4 py-6">

        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-gray-900">Recent Transactions</h2>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-10">
                <i class="fa-solid fa-receipt text-4xl text-gray-300"></i>
                <p class="mt-3 text-sm text-gray-400">No transactions yet.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var tx in Model)
                {
                    var (sign, amountClass) = AmountStyle(tx);
                    <div class="w-full p-4 sm:p-5 bg-white border border-gray-100 rounded-xl shadow-sm transition hover:shadow-md flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between pb-3 border-b border-gray-100">
                                <div>
                                    <span class="block text-xs font-medium text-gray-400 mb-1">Transaction ID</span>
                                    <div class="flex items-center gap-2">
                                        <span id="tx-id-@tx.Id" class="text-sm font-bold text-gray-800 tracking-wide break-all">@tx.Reference</span>
                                        <button type="button" onclick="copyTxId('@tx.Id')"
                                                class="text-gray-400 hover:text-gray-600 transition focus:outline-none relative">
                                            <i id="copy-icon-@tx.Id" class="fa-regular fa-copy text-xs"></i>
                                            <span id="copy-tooltip-@tx.Id"
                                                  class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden bg-gray-900 text-white text-[10px] px-2 py-0.5 rounded shadow-md whitespace-nowrap">Copied!</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="text-right pl-4 shrink-0">
                                    <span class="block text-xs font-medium text-gray-400 mb-1">Amount</span>
                                    <span class="text-base font-bold @amountClass">@sign₦@tx.Amount.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between py-2.5 border-b border-gray-100 text-xs">
                                <div class="flex items-center gap-1.5 text-gray-400 font-medium">
                                    <i class="fa-regular fa-clock"></i>
                                    <span>@tx.CreatedAt.ToRelativeString()</span>
                                </div>
                                <div class="font-semibold @StatusClass(tx.Status) capitalize">@tx.Status.ToLower()</div>
                            </div>
                        </div>
                        <div class="pt-2.5">
                            <h3 class="text-sm font-bold text-gray-800">@FriendlyTitle(tx)</h3>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>

@section Scripts {
    <script>
        function copyTxId(cardId) {
            const textToCopy = document.getElementById(`tx-id-${cardId}`).innerText;
            const copyIcon = document.getElementById(`copy-icon-${cardId}`);
            const tooltip = document.getElementById(`copy-tooltip-${cardId}`);

            navigator.clipboard.writeText(textToCopy).then(() => {
                copyIcon.className = 'fa-solid fa-circle-check text-green-500 text-xs';
                tooltip.classList.remove('hidden');
                setTimeout(() => {
                    copyIcon.className = 'fa-regular fa-copy text-xs';
                    tooltip.classList.add('hidden');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy text string: ', err);
            });
        }
    </script>
}