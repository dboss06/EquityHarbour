@model EquityHarbour.Models.ViewModels.DepositViewModel
@{
    ViewData["Title"] = "Deposit";
}

<nav class="fixed top-0 left-0 w-full bg-white shadow-gray-100 z-50">
    <div class="flex items-center justify-between px-8 md:px-12 lg:px-50 py-2">
        <div class="flex items-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="flex flex-col items-center gap-1 text-blue-950">
                <span class="material-symbols-rounded icon-fill">arrow_back_ios</span>
            </a>
        </div>
        <div class="text-center">
            <h1 class="text-lg font-medium text-gray-700">Deposit</h1>
        </div>
        <div class="flex items-center gap-1.5 text-sm font-medium px-3 py-1 rounded-full">
            <a asp-controller="Transactions" asp-action="Index" class="text-md font-medium text-blue-950">History</a>
        </div>
    </div>
</nav>

<main class="pt-10 pb-20 min-h-screen bg-gray-100">
    <div class="mt-2 mx-2 md:mx-12 lg:mx-75 bg-gradient-to-b from-blue-900 to-blue-950 text-white rounded-xl p-7 px-3 md:p-6 lg:p-3 shadow-sm">
        <div class="pb-1">
            <p class="mt-1 text-sm font-medium text-gray-300">My Balance</p>
            <h1 class="text-2xl font-bold">₦@Model.CurrentBalance.ToString("N2")</h1>
        </div>
    </div>

    <div class="mt-2 mx-2 md:mx-12 lg:mx-75 bg-[#E7E5F3] rounded-xl">
        <div class="pb-1">
            <p class="p-2 mt-1 text-md font-medium text-purple-500">Minimum Deposit: ₦3,000.00</p>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mt-2 mx-2 md:mx-12 lg:mx-75 rounded-lg bg-red-50 text-red-700 text-sm px-4 py-2">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="Deposit" asp-action="Create" method="post" id="depositForm" enctype="multipart/form-data" class="mt-2 mx-2 md:mx-12 lg:mx-75 bg-white rounded-xl shadow-sm">
        @Html.AntiForgeryToken()

        <div class="p-4">
            <h1 class="p-2 mt-1 text-sm font-medium text-gray-800">Select Account</h1>
            <div class="space-y-2 px-2">
                @foreach (var (account, index) in Model.Accounts.Select((a, i) => (a, i)))
                {
                    <label class="account-option flex items-center justify-between rounded-[10px] border @(index == 0 ? "border-blue-950 bg-blue-50" : "border-gray-200") px-4 py-3 cursor-pointer">
                        <input type="radio" name="accountId" value="@account.Id" class="account-radio sr-only" checked="@(index == 0)"
                               data-bank="@account.BankName" data-number="@account.AccountNumber" data-name="@account.AccountName">
                        <div>
                            <p class="text-sm font-semibold text-gray-800">@account.BankName</p>
                            <p class="text-xs text-gray-500">@account.AccountNumber &middot; @account.AccountName</p>
                        </div>
                        <i class="fa-solid fa-building-columns text-blue-950"></i>
                    </label>
                }
                @if (!Model.Accounts.Any())
                {
                    <p class="text-sm text-red-500 px-2">No deposit accounts are currently available. Please contact support.</p>
                }
            </div>
        </div>

        <div class="p-3">
            <h1 class="p-2 mt-1 text-md font-medium text-gray-500">Enter Amount:</h1>
            <div class="px-2 flex border-b border-gray-400 items-center transition-colors focus-within:border-blue-950">
                <span class="p-1 m-3 text-2xl font-bold text-gray-700">₦</span>
                <input asp-for="Amount" type="number" placeholder="Enter Amount"
                       class="text-lg focus:placeholder:text-gray-500 p-3 w-full border-0 bg-transparent py-2 outline-none placeholder:text-gray-400">
            </div>
            <span asp-validation-for="Amount" class="text-xs text-red-600 px-2"></span>
            <div class="mt-4">
                <label asp-for="UserProvidedReference" class="block text-sm font-medium text-gray-700 mb-1">Transfer Reference / Narration</label>
                <input asp-for="UserProvidedReference" type="text" placeholder="e.g. the reference shown on your bank app after transfer"
                       class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm outline-none focus:border-blue-950">
                <p class="text-xs text-gray-400 mt-1">Optional, but helps us match your transfer faster.</p>
            </div>

            <div class="mt-4">
                <label asp-for="ProofImage" class="block text-sm font-medium text-gray-700 mb-1">Proof of Payment</label>
                <input asp-for="ProofImage" type="file" accept=".jpg,.jpeg,.png,.webp"
                       class="w-full text-sm text-gray-600 border border-gray-200 rounded-lg px-3 py-2">
                <p class="text-xs text-gray-400 mt-1">Screenshot or photo of your transfer receipt (JPG, PNG or WEBP, max 5MB).</p>
            </div>
            <div class="mx-4 mt-5 sm:mx-8 md:mx-16 lg:mx-40">
                <button type="button" id="proceedBtn"
                        class="flex w-full justify-center rounded-lg bg-blue-950 px-4 py-3 hover:bg-blue-900">
                    <span class="text-center text-sm font-bold text-white transition sm:text-base">
                        Proceed to payments
                    </span>
                </button>
            </div>
        </div>
    </form>

    <!-- Confirmation modal -->
    

    

    <div class="mt-2 mx-2 md:mx-12 lg:mx-75 bg-white rounded-xl shadow-sm">
        <div class="p-2">
            <h1 class="pt-3 pb-2 px-3 text-lg font-extrabold text-gray-800">Instructions</h1>
            <p class="px-3 mb-2 text-md font-medium text-gray-800"><i class="fa-solid fa-circle-check" style="color: #2ecc71;"></i> Minimum deposit: ₦3,000.00.</p>
            <p class="px-3 mb-2 text-md font-medium text-gray-800"><i class="fa-solid fa-circle-check" style="color: #2ecc71;"></i> Ensure to send the exact amount initiated to avoid loss of funds.</p>
            <p class="px-3 mb-2 text-md font-medium text-gray-800"><i class="fa-solid fa-circle-check" style="color: #2ecc71;"></i> For security reasons, only initiate deposits through the platform.</p>
            <p class="px-3 mb-2 text-md font-medium text-gray-800"><i class="fa-solid fa-circle-check" style="color: #2ecc71;"></i> No official personnel will ever ask you for account information or password, don't fall for scams.</p>
            <p class="px-3 mb-2 text-md font-medium text-gray-800"><i class="fa-solid fa-circle-check" style="color: #2ecc71;"></i> If you encounter issues with your deposit please contact our support team to sort it out.</p>
        </div>
    </div>
</main>
<div id="depositModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 px-4">
    <div class="w-full max-w-md rounded-xl bg-white p-6">
        <h2 class="text-lg font-bold text-gray-800">Confirm Deposit Account</h2>
        <p class="mt-1 text-sm text-gray-500">Send your deposit to the account below.</p>

        <div class="mt-4 rounded-lg bg-blue-50 border border-blue-100 p-4 space-y-2">
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Bank</span>
                <span id="modalBank" class="font-bold text-gray-800"></span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Account Number</span>
                <span id="modalNumber" class="font-bold text-gray-800"></span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Account Name</span>
                <span id="modalName" class="font-bold text-gray-800"></span>
            </div>
            <div class="flex justify-between text-sm pt-2 border-t border-blue-100">
                <span class="text-gray-500">Amount</span>
                <span id="modalAmount" class="font-bold text-gray-800"></span>
            </div>
        </div>

        <div class="mt-5 flex gap-3">
            <button type="button" id="modalCancel" class="flex-1 rounded-lg border border-gray-200 py-2 text-sm font-semibold text-gray-600">Back</button>
            <button type="button" id="modalConfirm" class="flex-1 rounded-lg bg-blue-950 py-2 text-sm font-semibold text-white">Confirm</button>
        </div>
    </div>
</div>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
                const depositModal = document.getElementById("depositModal");
                const proceedBtn = document.getElementById("proceedBtn");
                const depositForm = document.getElementById("depositForm");

                proceedBtn.addEventListener("click", () => {
                    const amountInput = depositForm.querySelector("[name='Amount']");
                    const selected = document.querySelector(".account-radio:checked");

                    if (!amountInput.value || parseFloat(amountInput.value) <= 0) {
                        alert("Enter a valid amount.");
                        return;
                    }
                    if (!selected) {
                        alert("Select a deposit account.");
                        return;
                    }

                    document.getElementById("modalBank").textContent = selected.dataset.bank;
                    document.getElementById("modalNumber").textContent = selected.dataset.number;
                    document.getElementById("modalName").textContent = selected.dataset.name;
                    document.getElementById("modalAmount").textContent = "₦" + parseFloat(amountInput.value).toLocaleString("en-NG", { minimumFractionDigits: 2 });

                    depositModal.classList.remove("hidden");
                    depositModal.classList.add("flex");
                });

                document.getElementById("modalCancel").addEventListener("click", () => {
                    depositModal.classList.add("hidden");
                    depositModal.classList.remove("flex");
                });

                document.getElementById("modalConfirm").addEventListener("click", () => {
                    depositForm.submit();
                });

                // Visual selection state for account cards
                document.querySelectorAll(".account-radio").forEach(radio => {
                    radio.addEventListener("change", () => {
                        document.querySelectorAll(".account-option").forEach(opt => {
                            opt.classList.remove("border-blue-950", "bg-blue-50");
                            opt.classList.add("border-gray-200");
                        });
                        radio.closest(".account-option").classList.remove("border-gray-200");
                        radio.closest(".account-option").classList.add("border-blue-950", "bg-blue-50");
                    });
                });
        </script>
    }
