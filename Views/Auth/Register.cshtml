@model EquityHarbour.DTOs.Auth.RegisterRequest
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - EquityInv</title>
    <link rel="stylesheet" href="~/src/output.css" />
    <link rel="icon" href="~/assets/favicon.png" type="image/x-icon" />
</head>
<body class="min-h-screen bg-[#f5f5f5]">
    <main class="flex min-h-[calc(100vh-2px)] items-center justify-center px-4">
        <div class="w-full max-w-[500px] rounded-[18px] bg-white px-4 py-4 sm:px-5">
            <div class="flex justify-center">
                <img src="~/assets/logo.png" alt="Equity Inv" class="h-20 w-10object-contain">
            </div>
            <div class="mt-1 text-center">
                <h1 class="text-[21px] font-bold leading-tight text-gray-900 sm:text-[24px]">
                    Create Account
                </h1>
                <p class="mt-0.5 text-[12px] text-gray-500 sm:text-[14px]">
                    Join Equity Inv now
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-3 rounded-[8px] bg-red-50 px-3 py-2 text-[12px] text-red-700">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Register" asp-controller="Auth" method="post" class="mt-3" id="registerForm">
                <div>
                    <label asp-for="FullName" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">Full Name</label>
                    <input asp-for="FullName" autocomplete="name" placeholder="Enter your full name"
                           class="h-[38px] w-full rounded-[8px] border border-[#d2d2d2] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>
                <div class="mt-3">
                    <label asp-for="EmailAddress" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">Email Address</label>
                    <input asp-for="EmailAddress" type="email" autocomplete="email" placeholder="Enter email address"
                           class="h-[38px] w-full rounded-[8px] border border-[#d2d2d2] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>
                <div class="mt-3">
                    <label asp-for="Password" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">Password</label>
                    <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Enter password"
                           class="h-[38px] w-full rounded-[8px] border border-[#d2d2d2] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>
                <div class="mt-3">
                    <label for="confirmPassword" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">Confirm Password</label>
                    <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"
                           placeholder="Confirm password"
                           class="h-[38px] w-full rounded-[8px] border border-[#d2d2d2] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>
                <input type="hidden" asp-for="ReferralCode" />
                <button type="submit" id="registerButton"
                        class="mt-8 h-[46px] w-full rounded-[9px] bg-blue-950 text-[13px] font-bold text-white transition hover:bg-[#c99018] active:scale-[0.99]">
                    <span id="buttonText">Create Account</span>
                    <span id="buttonLoading" class="hidden">Creating Account...</span>
                </button>
            </form>
            <p class="mt-5 text-center text-[12px] text-[#707070]">
                Already have an account?
                <a asp-action="Login" asp-controller="Auth" class="font-medium text-blue-950 hover:underline">Sign In</a>
            </p>
        </div>
    </main>
</body>
</html>
<script>
    const registerForm = document.getElementById("registerForm");
    registerForm.addEventListener("submit", function (event) {
        const password = document.getElementById("password").value;
        const confirmPassword = document.getElementById("confirmPassword").value;
        if (password !== confirmPassword) {
            event.preventDefault();
            alert("Passwords do not match.");
            return;
        }
        document.getElementById("registerButton").disabled = true;
        document.getElementById("buttonText").classList.add("hidden");
        document.getElementById("buttonLoading").classList.remove("hidden");
    });
</script>