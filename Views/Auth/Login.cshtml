@model EquityHarbour.DTOs.Auth.LoginRequest
@{
    Layout = null; // auth pages usually stand alone, outside the main _Layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - EquityInv</title>
    <link rel="stylesheet" href="~/src/output.css" />
    <link rel="icon" href="~/assets/favicon.png" type="image/x-icon" />
</head>
<body class="min-h-screen bg-[#f5f5f5]">
    <main class="flex min-h-[calc(100vh-2px)] items-center justify-center px-4">
        <div class="w-full max-w-[500px] rounded-[18px] bg-white px-4 py-4 sm:px-5">
            <div class="flex justify-center">
                <img src="~/assets/logo.png" alt="Equity Inv" class="h-20 w-10object-contain">
            </div>
            <div class="mt-1 text-center">
                <h1 class="text-[21px] font-bold leading-tight text-gray-900 sm:text-[24px]">
                    Welcome Back
                </h1>
                <p class="mt-0.5 text-[12px] text-gray-500 sm:text-[14px]">
                    Login to your Equity Inv account to continue.
                </p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-3 rounded-[8px] bg-red-50 px-3 py-2 text-[12px] text-red-700">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="Login" asp-controller="Auth" method="post" class="mt-3" id="loginForm">
                <div>
                    <label asp-for="EmailAddress" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">
                        Email Address
                    </label>
                    <input asp-for="EmailAddress" placeholder="Enter email address"
                           class="h-[38px] w-full border border-[#d2d2d2] rounded-[8px] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>
                <div class="mt-3">
                    <label asp-for="Password" class="mb-1 block pl-2 text-[12px] font-medium text-[#111827]">
                        Password
                    </label>
                    <input asp-for="Password" type="password" autocomplete="current-password"
                           placeholder="Enter password"
                           class="h-[38px] border border-[#d2d2d2] w-full rounded-[8px] bg-[#e7eefb] px-2 text-[12px] text-[#111827] outline-none placeholder:text-[#777] focus:ring-2 focus:ring-[#d6a52d]">
                </div>

                <button type="submit" id="loginButton"
                        class="mt-8 h-[46px] w-full rounded-[9px] bg-blue-950 text-[13px] font-bold text-white transition hover\:bg-blue-950 hover:opacity-90 active:scale-[0.99]">
                    <span id="buttonText">Sign in</span>
                    <span id="buttonLoading" class="hidden">Signing in...</span>
                </button>
            </form>
            <p class="mt-5 text-center text-[12px] text-[#707070]">
                Don't have an account?
                <a asp-action="Register" asp-controller="Auth" class="font-medium text-blue-950 hover:underline">
                    Sign Up
                </a>
            </p>
        </div>
    </main>
</body>
</html>
<script>
    // Purely cosmetic now — the form does a normal POST + server redirect,
    // this just shows the spinner while that navigation happens.
    document.getElementById("loginForm").addEventListener("submit", function () {
        document.getElementById("loginButton").disabled = true;
        document.getElementById("buttonText").classList.add("hidden");
        document.getElementById("buttonLoading").classList.remove("hidden");
    });
</script>